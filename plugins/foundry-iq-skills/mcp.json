{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "azure": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure/mcp@latest", "server", "start"]
    },
    "foundry-iq-graph": {
      "type": "stdio",
      "command": "node",
      "args": ["./runtime/launch-python.mjs", "run", "entity", "foundry-iq-graph"]
    }
  }
}
