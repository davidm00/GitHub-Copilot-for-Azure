{
  "mcpServers": {
    "azure": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    },
    "foundry-iq-graph": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/graph/runtime/launch-python.mjs",
        "run",
        "entity",
        "foundry-iq-graph"
      ]
    }
  }
}
